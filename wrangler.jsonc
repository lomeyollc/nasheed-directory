{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nasheed-directory",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],

  // Static frontend (Vite build output). Any route that isn't a static file
  // or one of the run_worker_first patterns falls through to index.html so
  // React Router can handle it.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/audio/*", "/llms.txt", "/openapi.json"]
  },

  // D1 is the source of truth for the catalog. The catalog is small
  // (hundreds of rows) and read-heavy, so there is no Durable Object here —
  // unlike Hive, nothing needs per-entity durable coordination.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nasheed-directory",
      "database_id": "579f601b-c033-48e0-8f28-e556f57cbd0e",
      "migrations_dir": "./migrations"
    }
  ],

  // R2 holds the actual audio. Every published track is served from here, so
  // a consumer never depends on the original host staying up — which is the
  // whole point of the archive.
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "nasheed-audio" }],

  "observability": { "enabled": true },

  // Custom domain. Cloudflare provisions the DNS record and certificate for
  // this hostname automatically on deploy, because lomeyo.com is already a
  // zone on this account.
  "routes": [{ "pattern": "nasheed.lomeyo.com", "custom_domain": true }],

  "vars": { "APP_URL": "https://nasheed.lomeyo.com" }

  // Secrets (never committed, set with `wrangler secret put <NAME>`):
  //   ADMIN_TOKEN    - the maintainer token; the only one that may write
  //                    tracks or approve submissions.
  //   SESSION_SECRET - HMAC key for the review-UI cookie.
}
